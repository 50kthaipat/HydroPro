# Multi-stage Dockerfile for HydroFlow SCADA Frontend
FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend-scada/package*.json ./
RUN npm ci || npm install

COPY frontend-scada/ .
RUN npm run build

# Runtime stage - serve production bundle via high-performance Nginx
FROM nginx:alpine AS runner

COPY --from=builder /app/dist /usr/share/nginx/html

RUN printf 'server {\n    listen 3000;\n    server_name localhost;\n    location / {\n        root /usr/share/nginx/html;\n        index index.html index.htm;\n        try_files $uri $uri/ /index.html;\n    }\n}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
